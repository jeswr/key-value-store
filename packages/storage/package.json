{
  "name": "@key-value-kit/storage",
  "version": "0.1.0-alpha.0",
  "description": "Memory, Web Storage and IndexedDB adapters for asynchronous key-value storage.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/key-value-store.git",
    "directory": "packages/storage"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./web-storage": {
      "types": "./dist/web-storage.d.ts",
      "import": "./dist/web-storage.js",
      "default": "./dist/web-storage.js"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb.d.ts",
      "import": "./dist/indexeddb.js",
      "default": "./dist/indexeddb.js"
    }
  },
  "dependencies": {
    "@key-value-kit/core": "0.1.0-alpha.0",
    "idb-keyval": "^6.3.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "tsc -b"
  }
}
